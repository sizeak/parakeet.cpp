# Configuration for parakeet-server.service. Copy to ~/.config/parakeet-server.env
#
# These are the *server* images: build them with `--target runtime-server`
# (the default target builds the cli image, which has a different entrypoint).
#
# Switch backend by swapping which PARAKEET_IMAGE / PARAKEET_GPU_ARGS pair is
# uncommented, then: systemctl --user restart parakeet-server

PARAKEET_PORT=8080
# Absolute path -- systemd specifiers like %h are NOT expanded in an
# EnvironmentFile. Leave unset to take the unit's default of ~/models.
#PARAKEET_MODELS_DIR=/home/youruser/models
# Filename inside PARAKEET_MODELS_DIR. tdt-1.1b-q8_0 is the accuracy pick,
# tdt_ctc-110m-q8_0 the speed pick -- see benchmarks/BENCHMARK.md.
PARAKEET_MODEL=tdt-1.1b-q8_0.gguf

# --- Vulkan (default: faster on long-form audio, 416 MB image, no host ROCm) ---
PARAKEET_IMAGE=parakeet.cpp:vulkan-server
PARAKEET_GPU_ARGS=--device /dev/dri

# --- ROCm/HIP (AMD only; see the gfx1103 note in the README before using it
#     on a Phoenix APU -- the HSA_OVERRIDE below is what makes a 780M work) ---
#PARAKEET_IMAGE=parakeet.cpp:rocm-server
#PARAKEET_GPU_ARGS=--device /dev/kfd --device /dev/dri --group-add video --group-add render --security-opt seccomp=unconfined -e HSA_OVERRIDE_GFX_VERSION=11.0.2

# --- CPU only ---
#PARAKEET_IMAGE=parakeet.cpp:vulkan-server
#PARAKEET_GPU_ARGS=-e PARAKEET_DEVICE=cpu
