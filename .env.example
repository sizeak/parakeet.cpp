# Copy to .env beside compose.yaml. Every value has a working default, so this
# file is only needed to override one.

# Where your .gguf models live. Default: ./models
#PARAKEET_MODELS_DIR=./benchmarks/models

# Filename inside PARAKEET_MODELS_DIR. tdt-1.1b-q8_0 is the accuracy pick
# (1.06% WER), tdt_ctc-110m-q8_0 the speed pick -- see benchmarks/BENCHMARK.md.
#PARAKEET_MODEL=tdt-1.1b-q8_0.gguf

# Host port for the OpenAI-compatible API. Default: 8080
#PARAKEET_PORT=8080

# ROCm profile only: AMD archs to compile. Narrowing this to your own card cuts
# build time a lot. `rocminfo | grep gfx` prints it (but a gfx1103 Phoenix APU
# must be built as gfx1102 -- see the README).
#PARAKEET_GPU_TARGETS=gfx1102
